# Copy to .env and set for your classroom. No secrets go in this file.
# Host NIC on the classroom network (the hypervisor bridge the team VMs use).
LAB_PARENT_IF=ens18
LAB_SUBNET=192.0.2.0/24
LAB_GATEWAY=192.0.2.254
# Fixed addresses for the instructor services: keep them out of the DHCP range
# and off the team VMs. The decks use 192.0.2.53 (registry) and 192.0.2.40 (DoQ).
PARENT_ADDR=192.0.2.53
# Module 8 day only: set DOQ_ADDR and COMPOSE_PROFILES=m08 (Knot DoQ demo).
# Empty DOQ_ADDR: doq.example is not delegated.
DOQ_ADDR=
COMPOSE_PROFILES=
# Classroom directory (holds teams.conf) and handout directory, relative to here
CLASSROOM_DIR=./classroom
HANDOUT_DIR=./handout
# Owner of the handout files on the host (your uid/gid: `id -u`, `id -g`)
HANDOUT_UID=1000
HANDOUT_GID=1000
# Debian 13 base image tag
DEBIAN_TAG=trixie-20261005-slim
