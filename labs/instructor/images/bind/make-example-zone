#!/bin/bash
# make-example-zone: write the unsigned example. zone (db.example) from
#   - the teams file: one "NN address" line per team (teamNN.example and
#     manualNN.example are delegated to that address),
#   - DOQ_ADDR and M01_CHILD_ADDR, when set: the Module 8 DoQ demo and the
#     Module 1 lab zones (fault zone names from M01_FAULT_LABELS), and
#   - ds/*.ds: the DS records published so far (publish-ds, lab-init).
# named signs it with the lab policy (inline signing); run `rndc reload
# example` afterwards if named is already running.
# LAB_STATE (default /var/lib/lab) is for tests: build into another directory.
set -euo pipefail
: "${PARENT_ADDR:?set PARENT_ADDR in .env}"
S=${LAB_STATE:-/var/lib/lab}
TEAMS=${TEAMS_FILE:-/etc/lab-classroom/teams.conf}
ipv4='^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$'
if [ -n "${M01_CHILD_ADDR:-}" ]; then
    [[ $M01_CHILD_ADDR =~ $ipv4 ]] || { echo "make-example-zone: bad M01_CHILD_ADDR: $M01_CHILD_ADDR" >&2; exit 1; }
    . /opt/lab/bin/m01-labels
    m01_labels || exit 1
fi

# The serial must grow on every rewrite, even twice in one second.
prev=$(cat "$S/serial" 2>/dev/null || true)
[[ $prev =~ ^[0-9]+$ ]] || prev=0
serial=$(date +%s)
[ "$serial" -gt "$prev" ] || serial=$((prev + 1))

tmp=$(mktemp "$S/db.example.XXXXXX")
trap 'rm -f "$tmp"' EXIT
{
    echo "\$TTL 60"
    echo "@         SOA ns1.example. hostmaster.example. $serial 3600 600 86400 60"
    echo "          NS  ns1.example."
    echo "ns1       A   $PARENT_ADDR"
    echo "; Lab 7.3 broken zones, served by this server"
    echo "expired   NS  ns1.example."
    echo "wrongds   NS  ns1.example."
    if [ -n "${DOQ_ADDR:-}" ]; then
        echo "; Module 8 DoQ demo (Knot)"
        echo "doq       NS  ns1.doq.example."
        echo "ns1.doq   A   $DOQ_ADDR"
    fi
    if [ -n "${M01_CHILD_ADDR:-}" ]; then
        # Module 1 lab hierarchy, served by the m01 child server: good is
        # correct; one fault per zone for Lab 1.3 (labels: m01-labels);
        # 198.51.100.0/24 (TEST-NET-2) has no server.
        n=$M01_L_NOTSERVED d=$M01_L_DEAD g=$M01_L_GLUE m=$M01_L_NSSET
        echo "; Module 1 lab zones"
        echo "good        NS  ns1.good.example."
        echo "ns1.good    A   $M01_CHILD_ADDR"
        echo "$n NS ns1.$n.example."
        echo "ns1.$n A $M01_CHILD_ADDR"
        echo "$d NS ns1.$d.example."
        echo "ns1.$d A 198.51.100.53"
        echo "$g NS ns1.$g.example."
        echo "$g NS ns2.$g.example."
        echo "ns1.$g A $M01_CHILD_ADDR"
        echo "ns2.$g A 198.51.100.54"
        echo "$m NS ns1.$m.example."
        echo "$m NS ns2.$m.example."
        echo "ns1.$m A $M01_CHILD_ADDR"
        echo "ns2.$m A $M01_CHILD_ADDR"
    fi
    echo "; teams"
    teams=" "
    while IFS= read -r line || [ -n "$line" ]; do
        read -r nn addr rest <<< "${line%%#*}"
        [ -n "${nn:-}" ] || continue
        if ! [[ $nn =~ ^[0-9]{2}$ && $addr =~ $ipv4 && -z $rest ]]; then
            echo "make-example-zone: bad line in $TEAMS: $nn $addr $rest" >&2
            exit 1
        fi
        teams+="$nn "
        # a team VM on an instructor address breaks that team's delegation
        for v in PARENT_ADDR DOQ_ADDR M01_ROOT_ADDR M01_CHILD_ADDR M01_RESOLVER_ADDR; do
            [ "${!v:-}" != "$addr" ] || echo "make-example-zone: warning: team $nn uses $v ($addr)" >&2
        done
        for z in team manual; do
            echo "$z$nn    NS  ns1.$z$nn.example."
            echo "ns1.$z$nn A   $addr"
        done
    done < "$TEAMS"
    echo "; DS records"
    shopt -s nullglob
    for f in "$S"/ds/*.ds; do
        z=$(basename "$f" .ds)
        case "$z" in
        expired.example|wrongds.example) ;;
        *)  nn=${z%.example}; nn=${nn: -2}
            if [[ $teams != *" $nn "* ]]; then
                # a DS without a delegation would make the zone fail to load
                echo "make-example-zone: team $nn is not in $TEAMS; not publishing $z DS (publish-ds $z --remove clears it)" >&2
                continue
            fi ;;
        esac
        cat "$f"
    done
} > "$tmp"

named-checkzone -q example "$tmp" || { named-checkzone example "$tmp" >&2; exit 1; }
chmod 0644 "$tmp"
mv "$tmp" "$S/db.example"
trap - EXIT
echo "$serial" > "$S/serial"
