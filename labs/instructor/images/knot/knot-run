#!/bin/bash
# knot-run: prepare and start Knot DNS for the Module 8 DoQ demo.
# Makes a self-signed certificate for doq.example (and DOQ_ADDR) when there is
# none or it expires within 7 days, and copies it to the handout directory as
# doq.crt for kdig's +tls-ca.
set -euo pipefail
: "${DOQ_ADDR:?set DOQ_ADDR in .env}"
D=/var/lib/knot-lab
H=/handout

install -d -o knot -g knot -m 0750 "$D" "$D/db" "$D/run"
# renew when missing, expiring within 7 days, or made for another DOQ_ADDR
if ! openssl x509 -checkend 604800 -noout -in "$D/doq.crt" 2>/dev/null \
   || ! openssl x509 -noout -ext subjectAltName -in "$D/doq.crt" | grep -q "IP Address:$DOQ_ADDR\b"; then
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
        -keyout "$D/doq.key" -out "$D/doq.crt" -days 30 -subj "/CN=doq.example" \
        -addext "subjectAltName=DNS:doq.example,IP:$DOQ_ADDR" 2>/dev/null
fi
chown knot:knot "$D/doq.key" "$D/doq.crt"
chmod 0600 "$D/doq.key"
install -m 0644 -o "${HANDOUT_UID:-0}" -g "${HANDOUT_GID:-0}" "$D/doq.crt" "$H/doq.crt"

sed "s/@DOQ_ADDR@/$DOQ_ADDR/" /etc/lab/doq.example.zone > "$D/doq.example.zone"
chown knot:knot "$D/doq.example.zone"
exec knotd -c /etc/lab/knot.conf
