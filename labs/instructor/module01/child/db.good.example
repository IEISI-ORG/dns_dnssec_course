; good.example: delegated correctly (the reference zone for Labs 1.1-1.3).
; One name server only: a lab simplification, RFC 1034 section 4.1 asks for two.
$TTL 300
@     SOA ns1.good.example. hostmaster.good.example. 1 3600 600 86400 60
      NS  ns1.good.example.
ns1   A   @M01_CHILD_ADDR@
www   A   192.0.2.80
www   AAAA 2001:db8::80
web   CNAME www
big   TXT "Lab 1.2: this record set is larger than 512 octets, so a 512-octet UDP answer must be truncated." "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
big   TXT "Second string set, to make the answer longer: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
big   TXT "Third string set: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
